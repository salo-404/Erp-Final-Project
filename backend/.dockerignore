# Secrets and local-only config - the container reads config from real
# environment variables at deploy/run time (see main.ts), never from a
# baked-in .env file.
.env
.env.*.local
.env.local

# Version control
.git
.gitignore

# Dependencies - reinstalled fresh in the image for a clean, reproducible
# build; never ship a host-installed node_modules into the build context.
node_modules

# Build output - regenerated inside the image (see Dockerfile), and a
# stale host-built dist/generated would only ever be wrong for the
# image's own architecture.
dist
generated

# Tests - not needed at runtime
test
coverage

# Editor/OS cruft
.vscode
.idea
.DS_Store
Thumbs.db

# Docs and local scratch
README.md
.env.example
