DATABASE_URL="postgresql://mini_erp:mini_erp@localhost:5432/mini_erp?schema=public"
AWS_REGION="eu-west-1"
COGNITO_USER_POOL_ID="eu-west-1_example"
COGNITO_APP_CLIENT_ID="replace-with-cognito-app-client-id"
# Separate service-only client: enable ADMIN_USER_PASSWORD_AUTH, use no client
# secret unless the AI client later implements SECRET_HASH.
COGNITO_SERVICE_APP_CLIENT_ID="replace-with-service-only-app-client-id"

# Optional seed mappings. Real Cognito users must already exist; development
# fallbacks are deliberately non-authenticating when these are omitted.
SEED_ADMIN_COGNITO_SUB=""
SEED_ADMIN_COGNITO_USERNAME=""
SEED_EMPLOYEE_COGNITO_SUB=""
SEED_EMPLOYEE_COGNITO_USERNAME=""
AI_SERVICE_COGNITO_SUB=""
AI_SERVICE_COGNITO_USERNAME=""
GEOAPIFY_API_KEY="replace-with-your-geoapify-api-key"
GEOAPIFY_TIMEOUT_MS="5000"

# The only origin CORS will allow (see main.ts) — the deployed frontend's
# URL. Leave unset for local dev (any http://localhost:<port> is allowed
# automatically); always set this in a real deployment.
FRONTEND_URL="replace-with-your-frontend-url"

# S3DocumentStorageService (backend/src/document-review/s3-document-storage.service.ts).
# AWS credentials are NOT set here — they come from the standard AWS
# credential provider chain (e.g. ~/.aws/credentials, env vars, instance
# role). Only non-secret configuration goes in this file.
AWS_S3_BUCKET="replace-with-your-s3-bucket-name"

# Textract AnalyzeExpense reads invoices from the private AWS_S3_BUCKET.
# Credentials come from the standard AWS SDK provider chain (the production
# backend runtime IAM role). That role needs textract:AnalyzeExpense in
# addition to the existing least-privilege S3 permissions.
TEXTRACT_TIMEOUT_MS="30000"
