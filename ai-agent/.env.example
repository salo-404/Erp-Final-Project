# ----------------------------------------------------------------------
# Model provider selection
# ----------------------------------------------------------------------
# "openai"  - local dev without AWS access (current default).
# "ollama"  - fully offline local dev against a local Ollama server.
# "bedrock" - target production provider (Amazon Nova Pro). Switching only
#             requires changing this value and filling in the Bedrock
#             settings below - no agent/tool code changes needed. See
#             README.md "Switching providers".
MODEL_PROVIDER=openai

# ----------------------------------------------------------------------
# OpenAI (used when MODEL_PROVIDER=openai)
# ----------------------------------------------------------------------
OPENAI_API_KEY=your-key-here



# Optional per-agent model ID overrides, used by whichever provider is
# active above. Leave blank to default to "gpt-5.4-mini" (openai),
# "llama3.1" (ollama), or BEDROCK_MODEL_ID (bedrock).
#
# SUPERVISOR_MODEL_ID is the Supervisor's MAIN routing/response model - the
# one that reads a query, picks a specialist tool, and composes the answer.
# It is separate from the future gate/classification model in
# agents/supervisor/gate.py, which has no model of its own yet (still a
# TODO placeholder, not part of this settings file).
SUPERVISOR_MODEL_ID=
INSIGHTS_MODEL_ID=
DOCUMENT_MODEL_ID=

# ----------------------------------------------------------------------
# AWS / Bedrock (used when MODEL_PROVIDER=bedrock)
# ----------------------------------------------------------------------
# AWS region for Bedrock AgentCore deployment.
AWS_REGION=eu-west-1

# Default Bedrock model ID (cross-region inference profile) used by every
# agent when MODEL_PROVIDER=bedrock and no per-agent override above is set.
# Verify this profile is enabled in your account/region via the Bedrock
# console before deploying.
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-5-v1:0

# AWS credentials are NOT set here - boto3's default credential chain
# (environment, shared config/credentials file, or IAM role) is used.
# Do not put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in this file for
# anything beyond local, non-shared development.

# AWS Bedrock AgentCore deployment identifiers (TODO: fill in once
# provisioned).
AGENTCORE_RUNTIME_ID=
AGENTCORE_ENDPOINT_NAME=DEFAULT

# Bedrock Guardrails (TODO: real guardrail not yet implemented, see
# agents/supervisor/guardrails.py). Only applied when MODEL_PROVIDER=bedrock.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ----------------------------------------------------------------------
# NestJS backend HTTP API
# ----------------------------------------------------------------------
# Required before real backend-backed tools are enabled. Do not include a
# trailing slash. BACKEND_AUTH_TOKEN is the JWT sent as a Bearer token.
BACKEND_BASE_URL=
BACKEND_AUTH_TOKEN=
BACKEND_REQUEST_TIMEOUT_SECONDS=10

# ----------------------------------------------------------------------
# General
# ----------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
