# ----------------------------------------------------------------------
# Model provider selection
# ----------------------------------------------------------------------
# "bedrock" - production/default target using AWS Bedrock.
# "openai" remains an optional local-development provider. When selecting
# it, replace every role-specific *_MODEL_ID below with a real model ID
# supported by that provider; there is intentionally no fallback.
MODEL_PROVIDER=bedrock

# ----------------------------------------------------------------------
# OpenAI
# ----------------------------------------------------------------------
OPENAI_API_KEY=your-key-here

# ----------------------------------------------------------------------
# Per-agent model IDs
# ----------------------------------------------------------------------
# Direct in-region Bedrock runtime IDs. Every role deliberately shares the
# same model - mistral.ministral-3-14b-instruct is the only model confirmed
# reachable and reliable in this account (GPT-OSS confirmed dead on live
# testing, Nova blocked by the org Bedrock SCP, Claude-Haiku denied).
SUPERVISOR_MODEL_ID=mistral.ministral-3-14b-instruct
INSIGHTS_MODEL_ID=mistral.ministral-3-14b-instruct
DOCUMENT_MODEL_ID=mistral.ministral-3-14b-instruct

# Supervisor scope-classification model.
GATE_MODEL_ID=mistral.ministral-3-14b-instruct

# Narration model used by Control Tower / supplier narration.
NARRATION_MODEL_ID=mistral.ministral-3-14b-instruct

# ----------------------------------------------------------------------
# AWS / Bedrock
# ----------------------------------------------------------------------
AWS_REGION=eu-west-1

# Generic fallback. Role-specific IDs above take precedence.
BEDROCK_MODEL_ID=

# Model used specifically for natural-language -> SQL generation.
BEDROCK_SQL_MODEL_ID=mistral.ministral-3-14b-instruct

# Embedding model used for QueryExample semantic retrieval.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=512

# AWS credentials are intentionally NOT stored here.
# Local development uses the AWS SDK/default credential chain.
# Production should use the runtime IAM role.

# ----------------------------------------------------------------------
# Bedrock AgentCore
# ----------------------------------------------------------------------
AGENTCORE_RUNTIME_ID=
AGENTCORE_ENDPOINT_NAME=DEFAULT

# Short-term conversation Memory for the Supervisor only. Leave the resource ID
# empty and required=false for local development before AWS provisioning. Set
# required=true in production after the Memory resource has been provisioned.
AGENTCORE_MEMORY_ID=
AGENTCORE_MEMORY_REQUIRED=false

# ----------------------------------------------------------------------
# Bedrock Guardrails
# ----------------------------------------------------------------------
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Future AgentCore CUSTOM_JWT deployment configuration. Deployment is not
# performed in this phase; Authorization must be included in its header allowlist.
AGENTCORE_COGNITO_DISCOVERY_URL=https://cognito-idp.REGION.amazonaws.com/USER_POOL_ID/.well-known/openid-configuration
AGENTCORE_ALLOWED_COGNITO_CLIENT_ID=
AGENTCORE_REQUEST_HEADER_ALLOWLIST=Authorization

# ----------------------------------------------------------------------
# NestJS backend HTTP API
# ----------------------------------------------------------------------
BACKEND_URL=http://localhost:3000/api

# Cognito user pool shared by AgentCore/frontend and the NestJS backend.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_SERVICE_APP_CLIENT_ID=

# Least-privilege Cognito EMPLOYEE service user. The separate service app
# client must enable ADMIN_USER_PASSWORD_AUTH and should have NO client secret
# (SECRET_HASH is not implemented). The user must have a permanent password,
# not FORCE_CHANGE_PASSWORD, and its cognitoSub must map to an EMPLOYEE User in
# PostgreSQL. AgentCore's execution role/local AWS identity must allow
# cognito-idp:AdminInitiateAuth. The resulting access token is accepted by the
# backend verifier alongside the frontend app client's access tokens.
BACKEND_SERVICE_COGNITO_USERNAME=
BACKEND_SERVICE_COGNITO_PASSWORD=

BACKEND_REQUEST_TIMEOUT_SECONDS=10

# ----------------------------------------------------------------------
# SQL-RAG database connection
# ----------------------------------------------------------------------
# There is no runtime database credential here at all. query_database()'s
# execution step and the pgvector example-retrieval step both run as SQL
# text sent to the real backend's POST /ai/query-database (authenticated
# via BACKEND_SERVICE_COGNITO_USERNAME/PASSWORD above, same as every other
# tool) - see sql/read_only_db.py and retrieval/query_example_repository.py.
# This exists because the AgentCore Runtime cannot reach RDS directly (it
# is not VPC-attached; RDS is private-only), and the backend already runs
# inside the VPC with a working DATABASE_URL.

# Maintenance/bootstrap only. Used by scripts/generate_query_embeddings.py to
# SELECT QueryExample and UPDATE QueryExample.embedding. Do NOT supply this
# credential to the AgentCore runtime - it is never read at runtime, only by
# that one offline script, run manually or as the last step of `npm run seed`.
# The role itself is NOT created by any Prisma migration/seed - create it once
# per database before this is usable:
#   CREATE ROLE erp_ai_embedding_writer WITH LOGIN PASSWORD '<pick one>';
#   GRANT SELECT, UPDATE ON "QueryExample" TO erp_ai_embedding_writer;
#   GRANT USAGE ON SCHEMA public TO erp_ai_embedding_writer;
# `npm run seed` (backend/) runs this script automatically as its last step -
# without the role above, that step (and therefore query_database()'s
# similarity search) fails silently empty rather than erroring loudly.
QUERY_EXAMPLE_WRITE_DATABASE_URL=

# ----------------------------------------------------------------------
# Document agent matching (agents/document_agent/matching_agent.py)
# ----------------------------------------------------------------------
# The real ERP backend reaches this through the SAME AgentCore
# /invocations endpoint the chat UI uses ("mode": "document_match" - see
# agentcore_entrypoint.py's invoke() docstring), authenticated with the
# reviewer's own human bearer token - no separate service secret needed.
#
# Timeout (seconds) for the Document agent's structured-output matching
# call - a real LLM completion. On timeout, this module raises
# DocumentAgentMatchTimeout, the document_match mode turns that into an
# in-stream "error" event, and the real backend falls back to its own
# fuzzy matcher instead.
DOCUMENT_MATCHING_TIMEOUT_SECONDS=12

# ----------------------------------------------------------------------
# General
# ----------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
