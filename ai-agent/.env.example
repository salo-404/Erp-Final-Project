# ----------------------------------------------------------------------
# Model provider selection
# ----------------------------------------------------------------------
# "openai"  - local development with OpenAI.
# "ollama"  - fully local/offline development.
# "bedrock" - production target using AWS Bedrock.
MODEL_PROVIDER=openai

# ----------------------------------------------------------------------
# OpenAI
# ----------------------------------------------------------------------
OPENAI_API_KEY=your-key-here

# ----------------------------------------------------------------------
# Ollama
# ----------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434

# ----------------------------------------------------------------------
# Per-agent model IDs
# ----------------------------------------------------------------------
# Leave blank to use the provider-specific defaults configured in
# config/settings.py.
SUPERVISOR_MODEL_ID=
INSIGHTS_MODEL_ID=
DOCUMENT_MODEL_ID=

# Lightweight Supervisor scope-classification model.
GATE_MODEL_ID=

# Lightweight narration model used by Control Tower / supplier narration.
NARRATION_MODEL_ID=

# ----------------------------------------------------------------------
# AWS / Bedrock
# ----------------------------------------------------------------------
AWS_REGION=eu-west-1

# Default Bedrock model used when an individual *_MODEL_ID is not provided.
# Verify the exact inference profile available in the deployment account
# before production deployment.
BEDROCK_MODEL_ID=

# Model used specifically for natural-language -> SQL generation.
BEDROCK_SQL_MODEL_ID=

# Embedding model used for QueryExample semantic retrieval.
BEDROCK_EMBEDDING_MODEL_ID=

# AWS credentials are intentionally NOT stored here.
# Local development uses the AWS SDK/default credential chain.
# Production should use the runtime IAM role.

# ----------------------------------------------------------------------
# Bedrock AgentCore
# ----------------------------------------------------------------------
AGENTCORE_RUNTIME_ID=
AGENTCORE_ENDPOINT_NAME=DEFAULT

# ----------------------------------------------------------------------
# Bedrock Guardrails
# ----------------------------------------------------------------------
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ----------------------------------------------------------------------
# NestJS backend HTTP API
# ----------------------------------------------------------------------
BACKEND_URL=http://localhost:3000

# Least-privilege AI service account used for normal backend read calls.
BACKEND_SERVICE_EMAIL=ai-agent@internal.local
BACKEND_SERVICE_PASSWORD=

BACKEND_REQUEST_TIMEOUT_SECONDS=10

# ----------------------------------------------------------------------
# SQL-RAG database connection
# ----------------------------------------------------------------------
# Current local development database.
# QueryExample lives in this SAME ERP PostgreSQL database.
AI_DATABASE_URL=postgresql://mini_erp:mini_erp@127.0.0.1:5433/mini_erp

# ----------------------------------------------------------------------
# General
# ----------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO