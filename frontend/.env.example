# Base URL of the NestJS backend (backend/src/main.ts — global /api prefix, PORT defaults to 3000).
VITE_API_URL="http://localhost:3000/api"

# Cognito User Pool backing sign-in (backend/src/auth/cognito-token-verifier.service.ts
# verifies access tokens against this same pool). The pool's region is derived
# from this ID's prefix (e.g. "eu-west-1_xxxxxxxxx") — no separate region var.
# The pool MUST have email configured as a sign-in alias (UsernameAttributes
# or AliasAttributes including "email") since the login form collects email,
# not the internal erp-<uuid> Cognito username assigned at user creation.
VITE_COGNITO_USER_POOL_ID="replace-with-cognito-user-pool-id"

# The frontend-only app client (not the service/AI app client) — no client
# secret, with ALLOW_USER_PASSWORD_AUTH enabled.
VITE_COGNITO_APP_CLIENT_ID="replace-with-cognito-app-client-id"

# ai-agent/agentcore_entrypoint.py run locally (python agentcore_entrypoint.py).
# Routed through the Vite dev-server proxy (vite.config.ts) since the local
# AgentCore server doesn't answer CORS preflights — use a relative path
# here, not the raw http://localhost:8080 origin.
VITE_AGENTCORE_URL="/agentcore"

# Local-dev-only Cognito bypass (src/auth/AuthContext.tsx's finishLocalLogin
# + backend's LOCAL_AUTH_MODE, see backend/.env.example) — for working on the
# app with no reachable Cognito pool at all. Real Cognito login is completely
# untouched; leave this unset/"false" to use it. When "true", the login
# form's password is ignored and any already-seeded user's email (e.g.
# admin@minierp.demo, employee@minierp.demo after `npm run seed:app`) signs
# in directly. NEVER set this in a real deployment.
VITE_LOCAL_AUTH_MODE="false"
