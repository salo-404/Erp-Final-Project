DATABASE_URL="postgresql://mini_erp:mini_erp@localhost:5432/mini_erp?schema=public"
AWS_REGION="eu-west-1"
COGNITO_USER_POOL_ID="eu-west-1_example"
COGNITO_APP_CLIENT_ID="replace-with-cognito-app-client-id"
# Separate service-only client: enable ADMIN_USER_PASSWORD_AUTH, use no client
# secret unless the AI client later implements SECRET_HASH.
COGNITO_SERVICE_APP_CLIENT_ID="replace-with-service-only-app-client-id"

# Optional seed mappings. Real Cognito users must already exist; development
# fallbacks are deliberately non-authenticating when these are omitted.
SEED_ADMIN_COGNITO_SUB=""
SEED_ADMIN_COGNITO_USERNAME=""
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_EMPLOYEE_COGNITO_SUB=""
SEED_EMPLOYEE_COGNITO_USERNAME=""
AI_SERVICE_COGNITO_SUB=""
AI_SERVICE_COGNITO_USERNAME=""

# The only origin CORS will allow (see main.ts) — the deployed frontend's
# URL. Leave unset for local dev (any http://localhost:<port> is allowed
# automatically); always set this in a real deployment.
FRONTEND_URL="replace-with-your-frontend-url"

# S3DocumentStorageService (backend/src/document-review/s3-document-storage.service.ts).
# AWS credentials are NOT set here — they come from the standard AWS
# credential provider chain (e.g. ~/.aws/credentials, env vars, instance
# role). Only non-secret configuration goes in this file.
AWS_S3_BUCKET="replace-with-your-s3-bucket-name"

# Textract AnalyzeExpense reads invoices from the private AWS_S3_BUCKET.
# Credentials come from the standard AWS SDK provider chain (the production
# backend runtime IAM role). That role needs textract:AnalyzeExpense in
# addition to the existing least-privilege S3 permissions.
TEXTRACT_TIMEOUT_MS="30000"

# AiSemanticMatchProvider (backend/src/document-review/ai-semantic-match.provider.ts)
# — calls the AI service's REAL AgentCore Runtime endpoint,
# POST {url}/invocations with "mode": "document_match" (the SAME endpoint
# the chat UI streams from), from resolveProduct()/resolveSupplier(). This
# reaches the real Document agent LLM (ai-agent/agents/document_agent/
# matching_agent.py) directly, authenticated as the current reviewer's own
# Cognito access token (forwarded, never a service secret) — a genuine
# model-reasoning call, not a quick lookup — falls back to the existing
# fuzzy matcher on any failure (network error, timeout, or an invalid/
# unverifiable result). Leave SEMANTIC_MATCH_SERVICE_URL unset to skip the
# semantic call entirely and always use the fuzzy matcher (e.g. a fresh
# checkout with no AI service running).
SEMANTIC_MATCH_SERVICE_URL="http://localhost:8080"
SEMANTIC_MATCH_TIMEOUT_MS="15000"

# Google Calendar/Gmail (backend/src/integrations/google-auth.ts, shared by
# CalendarService and EmailService). Both are the FULL JSON content of the
# files a one-time local setup produces - GOOGLE_OAUTH_CREDENTIALS_JSON is
# credentials/google-oauth.json (the OAuth client, from Google Cloud
# Console), GOOGLE_TOKEN_JSON is credentials/google-token.json (produced by
# running `npx ts-node authorize-google.ts` once, which opens a real
# browser consent flow). The refresh_token inside GOOGLE_TOKEN_JSON is what
# actually matters long-term - googleapis' OAuth2Client uses it to mint a
# fresh access token automatically, so this never needs re-provisioning on
# a schedule. Leave both unset to skip these features entirely - every
# caller (GET/POST /integrations/calendar/*, POST /integrations/email/send)
# fails closed with a clear "not configured" error rather than a raw
# filesystem error.
GOOGLE_OAUTH_CREDENTIALS_JSON=""
GOOGLE_TOKEN_JSON=""
