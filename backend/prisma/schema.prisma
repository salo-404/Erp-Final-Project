generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ====================
// ENUMS
// ====================

enum InventoryTransactionType {
  INCOMING
  OUTGOING
  TRANSFER
}

enum InventoryTransactionStatus {
  EXPECTED
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  INCOMING
  OUTGOING
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum ReservationStatus {
  ACTIVE
  FULFILLED
  CANCELLED
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}


// ====================
// USER
// ====================

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  approvedTransactions InventoryTransaction[]
}


// ====================
// PRODUCT
// ====================

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  category    String?
  description String?
  createdAt   DateTime @default(now())

  inventories      WarehouseInventory[]
  transactionItems InventoryTransactionItem[]
  stockMovements   StockMovement[]
  reservations     Reservation[]
}


// ====================
// WAREHOUSE
// ====================

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String
  location  String?
  createdAt DateTime @default(now())

  inventories WarehouseInventory[]

  sourceTransactions      InventoryTransaction[] @relation("SourceWarehouse")
  destinationTransactions InventoryTransaction[] @relation("DestinationWarehouse")

  stockMovements StockMovement[]
  reservations   Reservation[]
}


// ====================
// WAREHOUSE INVENTORY
// ====================

model WarehouseInventory {
  id               Int @id @default(autoincrement())
  productId        Int
  warehouseId      Int
  onHand           Int @default(0)
  reorderThreshold Int @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId])
}


// ====================
// INVENTORY TRANSACTION
// ====================

model InventoryTransaction {
  id                     Int                        @id @default(autoincrement())
  type                   InventoryTransactionType
  status                 InventoryTransactionStatus @default(EXPECTED)

  sourceWarehouseId      Int?
  destinationWarehouseId Int?

  expectedDate DateTime?
  actualDate   DateTime?

  partyName   String?
  documentUrl String?

  approvedById Int?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceWarehouse      Warehouse? @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse Warehouse? @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)

  approvedBy User? @relation(fields: [approvedById], references: [id], onDelete: Restrict)

  items          InventoryTransactionItem[]
  stockMovements StockMovement[]
  reservations   Reservation[]
}


// ====================
// INVENTORY TRANSACTION ITEM
// ====================

model InventoryTransactionItem {
  id            Int     @id @default(autoincrement())
  transactionId Int
  productId     Int
  quantity      Int
  price         Decimal?

  transaction InventoryTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
}


// ====================
// STOCK MOVEMENT
// ====================

model StockMovement {
  id            Int               @id @default(autoincrement())
  productId     Int
  warehouseId   Int
  type          StockMovementType
  quantity      Int
  transactionId Int?
  createdAt     DateTime          @default(now())

  product     Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  transaction InventoryTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
}


// ====================
// RESERVATION
// ====================

model Reservation {
  id            Int               @id @default(autoincrement())
  transactionId Int
  productId     Int
  warehouseId   Int
  quantity      Int
  status        ReservationStatus @default(ACTIVE)
  createdAt     DateTime          @default(now())

  transaction InventoryTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  product     Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
}