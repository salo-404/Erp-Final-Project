# Base URL of the NestJS backend (backend/src/main.ts — no route prefix, PORT env var defaults to 3000).
VITE_API_URL="http://localhost:3000"

# Cognito User Pool backing sign-in (backend/src/auth/cognito-token-verifier.service.ts
# verifies access tokens against this same pool). The pool's region is derived
# from this ID's prefix (e.g. "eu-west-1_xxxxxxxxx") — no separate region var.
# The pool MUST have email configured as a sign-in alias (UsernameAttributes
# or AliasAttributes including "email") since the login form collects email,
# not the internal erp-<uuid> Cognito username assigned at user creation.
VITE_COGNITO_USER_POOL_ID="replace-with-cognito-user-pool-id"

# The frontend-only app client (not the service/AI app client) — no client
# secret, with ALLOW_USER_PASSWORD_AUTH enabled.
VITE_COGNITO_APP_CLIENT_ID="replace-with-cognito-app-client-id"
