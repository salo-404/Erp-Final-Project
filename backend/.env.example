DATABASE_URL="postgresql://mini_erp:mini_erp@localhost:5432/mini_erp?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1h"
GEOAPIFY_API_KEY="replace-with-your-geoapify-api-key"

# S3DocumentStorageService (backend/src/document-review/s3-document-storage.service.ts).
# AWS credentials are NOT set here — they come from the standard AWS
# credential provider chain (e.g. ~/.aws/credentials, env vars, instance
# role). Only non-secret configuration goes in this file.
AWS_REGION="replace-with-your-aws-region"
AWS_S3_BUCKET="replace-with-your-s3-bucket-name"

# RibalDocumentExtractionProvider (backend/src/document-review/ribal-document-extraction.provider.ts).
# HTTP endpoint for Ribal's document-extraction agent. This app only POSTs
# { mimeType, documentUrl } to it and expects extracted invoice data back —
# the agent's own AI/Bedrock implementation is not part of this repo.
RIBAL_AGENT_URL="replace-with-ribal-agent-endpoint-url"
